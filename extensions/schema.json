{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fema-ffrd/ras-stac/extensions/schema.json#",
  "title": "HEC-RAS Extension",
  "description": "STAC extension for HEC-RAS models.",
  "oneOf": [
    {
      "$comment": "This is the schema for STAC Items.",
      "allOf": [
        {
          "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type",
            "properties",
            "assets"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "properties": {
              "allOf": [
                {
                    "$ref": "#/definitions/fields"
                },
                {
                  "$comment": "Required fields for item properties",
                  "required": [
                    "ras:project"
                  ]
                }
              ]
            },
            "assets": {
              "$ref": "#/definitions/assets"
            }
          }
        }
      ]
    },
    {
      "$comment": "Schema for STAC Collections",
      "allOf": [
        {
            "$ref": "#/definitions/stac_extensions"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "Collection"
            }
          }
        }
      ]
    }
  ],
  "definitions": {
    "stac_extensions": {
      "type": "object",
      "required": [
        "stac_extensions"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "contains": {
            "const": "https://github.com/fema-ffrd/ras-stac/extensions/schema.json"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "patternProperties": {
        ".*\\.prj$": {"$ref": "#/definitions/fields/properties/ras:prj_file"},
        ".*\\.[pP]\\d\\d$": {"$ref": "#/definitions/fields/properties/ras:plan"},
        ".*\\.[gG]\\d\\d$": {"$ref": "#/definitions/fields/properties/ras:geometry"},
        ".*\\.[fF]\\d\\d$": {"$ref": "#/definitions/fields/properties/ras:steady_flow"},
        ".*\\.[qQ]\\d\\d$": {"$ref": "#/definitions/fields/properties/ras:quasi_unsteady_flow"},
        ".*\\.[uU]\\d\\d$": {"$ref": "#/definitions/fields/properties/ras:unsteady_flow"},
        ".*": {"$ref": "#/definitions/fields/properties/generic_asset"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "properties": {
        "ras:project": {
          "type": "string",
          "description": "Name of the HEC-RAS project.  Ex: wet_creek.prj",
          "pattern": ".*\\.prj$"
        },
        "ras:project_title": {
          "type": "string",
          "description": "Title of the HEC-RAS project, as defined by 'Proj Title' in the .prj file."
        },
        "ras:units": {
          "type": "string",
          "description": "Units of the HEC-RAS project, as defined in the .prj file.",
          "pattern": "(SI|English)"
        },
        "ras:plan_files": {
          "type": "array",
          "description": "A list of plans associated with the HEC-RAS project, as defined in the .prj file.",
          "items": {
            "$ref": "#/definitions/fields/properties/ras:plan"
          }
        },
        "ras:geometry_files": {
          "type": "array",
          "description": "A list of geometry files associated with the HEC-RAS project.",
          "items": {
            "$ref": "#/definitions/fields/properties/ras:geometry"
          }
        },
        "ras:steady_flow_files": {
          "type": "array",
          "description": "A list of steady flow files associated with the HEC-RAS project.",
          "items": {
            "$ref": "#/definitions/fields/properties/ras:steady_flow"
          }
        },
        "ras:quasi_unsteady_flow_files": {
          "type": "array",
          "description": "A list of quasi-unsteady flow files associated with the HEC-RAS project.",
          "items": {
            "$ref": "#/definitions/fields/properties/ras:quasi_unsteady_flow"
          }
        },
        "ras:unsteady_flow_files": {
          "type": "array",
          "description": "A list of unsteady flow files associated with the HEC-RAS project.",
          "items": {
            "$ref": "#/definitions/fields/properties/ras:unsteady_flow"
          }
        },
        "ras:rivers": {
          "type": "integer",
          "description": "The number of rivers in the current geometry file."
        },
        "ras:reaches": {
          "type": "integer",
          "description": "The number of reaches in the current geometry file."
        },
        "ras:cross_sections": {
          "type": "object",
          "description": "Summary of the number of cross-sections in the current geometry file.",
          "properties": {
            "total": {"type": "integer"},
            "user_input_xss": {"type": "integer"},
            "interpolated": {"type": "integer"}
          }
        },
        "ras:culverts": {
          "type": "integer",
          "description": "The number of culverts in the current geometry file."
        },
        "ras:bridges": {
          "type": "integer",
          "description": "The number of bridges in the current geometry file."
        },
        "ras:multiple_openings": {
          "type": "integer",
          "description": "The number of multiple openings in the current geometry file."
        },
        "ras:inline_structures": {
          "type": "integer",
          "description": "The number of inline structures in the current geometry file."
        },
        "ras:lateral_structures": {
          "type": "integer",
          "description": "The number of lateral structures in the current geometry file."
        },
        "ras:storage_areas": {
          "type": "integer",
          "description": "The number of storage areas in the current geometry file."
        },
        "ras:2d_flow_areas": {
          "type": "object",
          "description": "Summary of The 2D flow areas in the current geometry file.",
          "properties": {
            "2d_flow_areas": {"type": "integer"},
            "total_cells": {"type": "integer"}
          }
        },
        "ras:sa_connections": {
          "type": "integer",
          "description": "The number of SA/2D connections in the current geometry file."
        },
        "ras:program_version": {
          "type": "string",
          "description": "HEC-RAS version last used to modify the file (ex. 4.1.0)."
        },
        "ras:prj_file": {
          "type": "object",
          "description": "A HEC-RAS project file.",
          "required": [
            "ras:project_title"
          ],
          "properties": {
            "title": {"type": "string"},
            "ras:project_title": {"type": "string"},
            "href": {
              "type": "string",
              "pattern": ".*\\.prj$"
            },
            "ras:plan_current": {"type": "string"}
          }
        },
        "ras:plan": {
          "type": "object",
          "description": "A HEC-RAS plan file.",
          "properties": {
            "title": {"type": "string"},
            "ras:short_id": {"type": "string"},
            "ras:program_version": {"$ref": "#/definitions/fields/properties/ras:program_version"},
            "ras:plan_title": {"type": "string"},
            "href": {
              "type": "string",
              "pattern": ".*\\.[pP]\\d\\d$"
            },
            "ras:file": {
              "type": "string",
              "pattern": ".*\\.[pP]\\d\\d$"
            },
            "ras:geometry": {"$ref": "#/definitions/fields/properties/ras:geometry"},
            "ras:flow": {"$ref": "#/definitions/fields/properties/ras:steady_flow"},
            "ras:unsteady": {"oneOf": [
              {"$ref": "#/definitions/fields/properties/ras:unsteady_flow"},
              {"$ref": "#/definitions/fields/properties/ras:quasi_unsteady_flow"}
            ]},
            "ras:geometry_file": {
              "type": "string",
              "pattern": ".*\\.[gG]\\d\\d$"
            },
            "ras:flow_file": {
              "type": "string",
              "pattern": ".*\\.[fF]\\d\\d$"
            }
          }
        },
        "ras:geometry": {
          "type": "object",
          "description": "A HEC-RAS geometry file.",
          "properties": {
            "title": {"type": "string"},
            "ras:geom_title": {"type": "string"},
            "ras:program_version": {"$ref": "#/definitions/fields/properties/ras:program_version"},
            "href": {
              "type": "string",
              "pattern": ".*\\.[gG]\\d\\d$"
            },
            "ras:file": {
              "type": "string",
              "pattern": ".*\\.[gG]\\d\\d$"
            },
            "ras:rivers": {"$ref": "#/definitions/fields/properties/ras:rivers"},
            "ras:reaches": {"$ref": "#/definitions/fields/properties/ras:reaches"},
            "ras:cross_sections": {"$ref": "#/definitions/fields/properties/ras:cross_sections"},
            "ras:culverts": {"$ref": "#/definitions/fields/properties/ras:culverts"},
            "ras:bridges": {"$ref": "#/definitions/fields/properties/ras:bridges"},
            "ras:multiple_openings": {"$ref": "#/definitions/fields/properties/ras:multiple_openings"},
            "ras:inline_structures": {"$ref": "#/definitions/fields/properties/ras:inline_structures"},
            "ras:lateral_structures": {"$ref": "#/definitions/fields/properties/ras:lateral_structures"},
            "ras:storage_areas": {"$ref": "#/definitions/fields/properties/ras:storage_areas"},
            "ras:2d_flow_areas": {"$ref": "#/definitions/fields/properties/ras:2d_flow_areas"},
            "ras:sa_connections": {"$ref": "#/definitions/fields/properties/ras:sa_connections"}
          }
        },
        "ras:steady_flow": {
          "type": "object",
          "description": "A HEC-RAS steady flow file.",
          "properties": {
            "title": {"type": "string"},
            "ras:flow_title": {"type": "string"},
            "ras:program_version": {"$ref": "#/definitions/fields/properties/ras:program_version"},
            "href": {
              "type": "string",
              "pattern": ".*\\.[fF]\\d\\d$"
            },
            "ras:file": {
              "type": "string",
              "pattern": ".*\\.[fF]\\d\\d$"
            },
            "ras:number_of_profiles": {"type": "integer"}
          }
        },
        "ras:quasi_unsteady_flow": {
          "type": "object",
          "description": "A HEC-RAS quasi-unsteady flow file.",
          "properties": {
            "title": {"type": "string"},
            "ras:flow_title": {"type": "string"},
            "ras:program_version": {"$ref": "#/definitions/fields/properties/ras:program_version"},
            "href": {
              "type": "string",
              "pattern": ".*\\.[qQ]\\d\\d$"
            },
            "ras:file": {
              "type": "string",
              "pattern": ".*\\.[qQ]\\d\\d$"
            }
          }
        },
        "ras:unsteady_flow": {
          "type": "object",
          "description": "A HEC-RAS unsteady flow file.",
          "properties": {
            "ras:flow_title": {"type": "string"},
            "ras:program_version": {"$ref": "#/definitions/fields/properties/ras:program_version"},
            "href": {
              "type": "string",
              "pattern": ".*\\.[uU]\\d\\d$"
            },
            "ras:file": {
              "type": "string",
              "pattern": ".*\\.[uU]\\d\\d$"
            }
          }
        },
        "generic_asset": {
          "type": "object",
          "description": "A generic (non-RAS) asset.",
          "properties": {
            "roles": {
              "type": "array",
              "not": {
                "contains": {
                  "const": "ras-file"
                }
              }
            }
          }

        }
      },
      "additionalProperties": true
    }
  }
}
